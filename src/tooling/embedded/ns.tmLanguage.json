{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "N&S",
  "scopeName": "source.ns",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#modules" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ns",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ns",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ns",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ns",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ns",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ns",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ns",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ns",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ns",
          "match": "\\b(if|else|while|for|in|return)\\b"
        },
        {
          "name": "storage.type.ns",
          "match": "\\b(let|func|extern|import|as)\\b"
        },
        {
          "name": "constant.language.ns",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "support.class.module.ns",
          "match": "\\b(web|game2d|cli|math|io)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.ns",
          "match": "\\b(print|input|random|browse|len|title|header|paragraph|slide|button)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ns",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ns",
          "match": "(\\+|-|\\*|/|%|==|!=|<=|>=|<|>|=|&&|\\|\\||!)"
        }
      ]
    }
  }
}
