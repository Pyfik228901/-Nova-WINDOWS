// ==========================================
// ОФИЦИАЛЬНАЯ ПРЕЗЕНТАЦИЯ ЯЗЫКА NOVASCRIPT
// Расширение файла: .nova
// ==========================================

print("Привет! Это интерактивный тур по языку NovaScript.")
print("Ниже мы разберем каждую команду и за что она отвечает.")
print("")

// ------------------------------------------
// 1. ПЕРЕМЕННЫЕ (let)
// Команда 'let' создает переменную и сохраняет в нее значение (число или текст).
// ------------------------------------------
let language_name = "NovaScript"
let version = 1
print("Имя языка:")
print(language_name)

// ------------------------------------------
// 2. ВВОД ДАННЫХ (input)
// Команда 'input' выводит текст на экран и ждет, пока пользователь введет ответ.
// ------------------------------------------
print("")
let user_name = input("Как тебя зовут? ")
print("Приятно познакомиться,")
print(user_name)

// ------------------------------------------
// 3. УСЛОВИЯ (if / else)
// Конструкция 'if' проверяет условие. Если оно верное, выполняется первый блок, 
// если нет — срабатывает ветка 'else'.
// ------------------------------------------
print("")
let score = 85
if score >= 80 {
    print("Отличный результат! Экзамен сдан на отлично.")
} else {
    print("Нужно еще немного потренироваться.")
}

// ------------------------------------------
// 4. ЦИКЛЫ (while)
// Цикл 'while' повторяет указанный блок кода до тех пор, пока условие истинно.
// ------------------------------------------
print("")
print("Обратный отсчет перед запуском:")
let count = 3
while count > 0 {
    print(count)
    let count = count - 1
}
print("Пуск!")

// ------------------------------------------
// 5. ПОЛЬЗОВАТЕЛЬСКИЕ ФУНКЦИИ (func)
// Позволяют создавать собственные мини-программы (функции) с аргументами и return.
// ------------------------------------------
print("")
func multiplyByTwo(number) {
    let result = number * 2
    return result
}

print("Результат работы функции multiplyByTwo(21):")
let calculated = multiplyByTwo(21)
print(calculated)

// ------------------------------------------
// 6. ГЕНЕРАТОР СЛУЧАЙНЫХ ЧИСЕЛ (random)
// Встроенная функция 'random(min, max)' выдает случайное число для игр.
// ------------------------------------------
print("")
print("Генерируем случайное бонусное число от 1 до 50:")
let lucky_bonus = random(1, 50)
print(lucky_bonus)

print("")
print("==========================================")
print("Конец презентации! Создавай свои программы на .nova!")
print("==========================================")