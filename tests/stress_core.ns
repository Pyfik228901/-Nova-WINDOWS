let math_check = 2 + 3 * 4 == 14 && (10 - 2) / 2 == 4
let str_check = "hello " + "world" == "hello world" && len("test") == 4
let logic_check = !false && !(10 < 5)

if math_check && str_check && logic_check {
    print(cli.green("  [OK] Приоритет операций и булевы выражения верны."))
} else {
    print(cli.red("  [FAIL] Ошибка в логике операторов!"))
}

print("")
print(cli.bold(cli.green("[OK] Все стресс-тесты ядра успешно пройдены!")))
