print("=== ТЕСТ СПИСКОВ В NOVASCRIPT ===")

// Создаем список (инвентарь игрока)
let inventory = ["Меч", "Щит", "Зелье здоровья"]

print("Весь инвентарь:")
print(inventory)

print("Первый предмет в списке:")
print(inventory[0])

print("Последний предмет в списке:")
print(inventory[2])

// Случайный выбор предмета с помощью рандомайзера!
let random_index = random(0, 2)
print("Случайный выбор из инвентаря под индексом:")
print(random_index)
for i = 1 to 5 {
    print(i)
}
print("=== ТЕСТ ЦИКЛА FOR ===")
for i = 1 to 3 {
    print("Шаг цикла:")
    print(i)
}
print("Цикл успешно завершен!")
// Пример использования словарей в NovaScript
