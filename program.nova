print("=== ТЕСТ МАТЕМАТИКИ И ЛОГИКИ В NOVASCRIPT ===")

// 1. Проверяем математические операции
let a = 20
let b = 5

let sum = a + b
let sub = a - b
let mult = a * b
let div = a / b

print("Результат сложения (20 + 5):")
print(sum)

print("Результат умножения (20 * 5):")
print(mult)

// 2. Проверяем сложные математические выражения со скобками
let math_result = (10 + 2) * 3
print("Пример со скобками (10 + 2) * 3:")
print(math_result)

// 3. Проверяем логические операторы и условия
let score = 15
let has_bonus = true

print("Проверка условий и логики:")

if score >= 10 and has_bonus == true {
    print("Ура! Ты набрал много очков и получил бонус!")
}

let is_night = false
let is_holiday = true

if is_night == true or is_holiday == true {
    print("Сегодня праздничный день или ночь — можно отдыхать!")
}

if not is_night {
    print("Сейчас день, работаем дальше!")
}

print("=== ВСЕ ТЕСТЫ УСПЕШНО ПРОШЛИ ===")
print("=== ТЕСТ ПОЛЬЗОВАТЕЛЬСКИХ ФУНКЦИЙ ===")

// Объявляем функцию сложения двух чисел
func add(x, y) {
    let result = x + y
    return result
}

// Объявляем функцию приветствия
func greet(name) {
    print("Привет, дорогой друг по имени:")
    print(name)
}

// Вызываем функции
greet("Алексей")

print("Результат работы функции add(15, 25):")
let sum_result = add(15, 25)
print(sum_result)
print("=== БРОСОК ИГРОВЫХ КУБИКОВ НА NOVASCRIPT ===")

// Генерируем случайное число от 1 до 6
let dice1 = random(1, 6)
let dice2 = random(1, 6)

print("Первый кубик:")
print(dice1)

print("Второй кубик:")
print(dice2)

let total = dice1 + dice2
print("Сумма очков:")
print(total)

if total >= 10 {
    print("Критический успех! Отличный бросок!")
}
